{
  "name": "FinVise - Fetch Prices (diario 22:00 COT)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 3 * * 2-6"
            }
          ]
        }
      },
      "id": "b1b2c3d4-0002-0002-0002-000000000001",
      "name": "Diario 22:00 (lun-vie)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://python-runner:8888/run",
        "sendBody": true,
        "contentType": "json",
        "body": "={\"script\": \"fetch_prices\"}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "b1b2c3d4-0002-0002-0002-000000000002",
      "name": "Ejecutar fetch_prices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "b1b2c3d4-0002-0002-0002-000000000003",
      "name": "¿Exitoso?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "level": "info",
        "message": "=✅ Precios actualizados: {{ $('Ejecutar fetch_prices').item.json.stdout }}"
      },
      "id": "b1b2c3d4-0002-0002-0002-000000000004",
      "name": "Log OK",
      "type": "n8n-nodes-base.executionData",
      "typeVersion": 1,
      "position": [900, 240]
    },
    {
      "parameters": {
        "level": "error",
        "message": "=❌ Error en fetch_prices: {{ $('Ejecutar fetch_prices').item.json.stderr }}"
      },
      "id": "b1b2c3d4-0002-0002-0002-000000000005",
      "name": "Log Error",
      "type": "n8n-nodes-base.executionData",
      "typeVersion": 1,
      "position": [900, 380]
    }
  ],
  "connections": {
    "Diario 22:00 (lun-vie)": {
      "main": [
        [{"node": "Ejecutar fetch_prices", "type": "main", "index": 0}]
      ]
    },
    "Ejecutar fetch_prices": {
      "main": [
        [{"node": "¿Exitoso?", "type": "main", "index": 0}]
      ]
    },
    "¿Exitoso?": {
      "main": [
        [{"node": "Log OK", "type": "main", "index": 0}],
        [{"node": "Log Error", "type": "main", "index": 0}]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  }
}
