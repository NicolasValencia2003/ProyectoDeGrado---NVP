{
  "name": "FinVise - Fetch Sentiment (cada 6h)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */6 * * *"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Cada 6 horas",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://python-runner:8888/run",
        "sendBody": true,
        "contentType": "json",
        "body": "={\"script\": \"fetch_sentiment\"}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000002",
      "name": "Ejecutar fetch_sentiment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000003",
      "name": "¿Exitoso?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "level": "info",
        "message": "=✅ Sentiment actualizado: {{ $('Ejecutar fetch_sentiment').item.json.stdout }}"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000004",
      "name": "Log OK",
      "type": "n8n-nodes-base.executionData",
      "typeVersion": 1,
      "position": [900, 240]
    },
    {
      "parameters": {
        "level": "error",
        "message": "=❌ Error en fetch_sentiment: {{ $('Ejecutar fetch_sentiment').item.json.stderr }}"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000005",
      "name": "Log Error",
      "type": "n8n-nodes-base.executionData",
      "typeVersion": 1,
      "position": [900, 380]
    }
  ],
  "connections": {
    "Cada 6 horas": {
      "main": [
        [{"node": "Ejecutar fetch_sentiment", "type": "main", "index": 0}]
      ]
    },
    "Ejecutar fetch_sentiment": {
      "main": [
        [{"node": "¿Exitoso?", "type": "main", "index": 0}]
      ]
    },
    "¿Exitoso?": {
      "main": [
        [{"node": "Log OK", "type": "main", "index": 0}],
        [{"node": "Log Error", "type": "main", "index": 0}]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  }
}
